{
	"schemaVersion": 1,
	"id": "chunksweeper",
	"version": "${version}",
	"name": "Chunk Sweeper",
	"description": "Removes unused chunks from singleplayer worlds when you leave them and from the backups made in the Edit World screen. Based on the Thanos library by Aternos.",
	"authors": [
		"Agustín Cantero"
	],
	"contact": {
		"homepage": "https://github.com/agustincantero/chunk-sweeper",
		"sources": "https://github.com/agustincantero/chunk-sweeper",
		"issues": "https://github.com/agustincantero/chunk-sweeper/issues"
	},
	"license": "MIT",
	"icon": "assets/chunksweeper/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.agustincantero.chunksweeper.client.ChunkSweeperClient"
		],
		"modmenu": [
			"com.agustincantero.chunksweeper.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "chunksweeper.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
